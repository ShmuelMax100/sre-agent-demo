# Copy to terraform.tfvars (ignored by Git) or use TF_VAR_* environment variables.
subscription_id = "00000000-0000-0000-0000-000000000000"
tenant_id       = "00000000-0000-0000-0000-000000000000"
location        = "swedencentral"
environment     = "demo"
project_name    = "sre-agent-demo"
name_suffix     = "abcd"

acr_sku                      = "Standard"
aks_node_count               = 2
aks_node_vm_size             = "Standard_D2ds_v5"
aks_sku_tier                 = "Free"
aks_operator_object_id       = null
aks_node_resource_group_name = "rg-aks-sreagent-demo-abcd"

github_repository          = "your-github-owner/your-sre-agent-demo-fork"
github_environment         = "demo"
github_repository_owner_id = 12345678
github_repository_id       = 123456789

enable_observability = true
enable_sre_agent     = true
enable_teams_bridge  = false

teams_tenant_id              = "00000000-0000-0000-0000-000000000000"
teams_team_id                = "00000000-0000-0000-0000-000000000000"
teams_channel_id             = "19:your-channel-id@thread.tacv2"
teams_allowed_user_object_id = "00000000-0000-0000-0000-000000000000"
teams_personal_chat_enabled        = false
teams_personal_chat_access_mode    = "allowed_user"
teams_personal_chat_turns_per_hour = 10

tags = {
  Owner = "your-alias-or-team"
}
